(kicad_pcb
  (version 20211014)
  (host pcbnew 6.0)
  (general
    (thickness 1.6)
    (drawings 0)
    (tracks 0)
  )

  (page A4)

  # Board outline (placeholder): 120 mm x 80 mm
  (setup
    (layers 4)
    (layer_stack (layer (index 0) (name "F.Cu") (type "signal")) (layer (index 1) (name "GND") (type "internal")) (layer (index 2) (name "PWR") (type "internal")) (layer (index 3) (name "B.Cu") (type "signal")))
    (board_outline (pts (xy 0 0) (xy 12000000 0) (xy 12000000 8000000) (xy 0 8000000)))
  )

  # Footprint placeholders (positions approximate). Replace with real footprints through KiCad.
  ; U1 STM32 LQFP48 at (30mm,40mm)
  (module STM32F103_LQFP48 (layer F.Cu) (tedit 0) (at 30 40) (attr through_hole)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
  )

  ; U2 TDA7439 near left edge at (15mm,40mm)
  (module TDA7439_SO (layer F.Cu) (tedit 0) (at 15 40) (attr through_hole)
    (fp_text reference U2 (at 0 0) (layer F.SilkS))
  )

  ; RCA inputs along left edge
  (module RCA_IN1 (layer F.Cu) (tedit 0) (at 2 60) (attr through_hole) (fp_text reference J_RCA_IN1 (at 0 0) (layer F.SilkS)))

  ; RCA outputs along bottom-right
  (module RCA_OUT1 (layer F.Cu) (tedit 0) (at 110 20) (attr through_hole) (fp_text reference J_RCA_OUT1 (at 0 0) (layer F.SilkS)))

  ; U3 MCP6002 near U2 at (25mm,50mm)
  (module MCP6002_SOIC8 (layer F.Cu) (tedit 0) (at 25 50) (attr through_hole) (fp_text reference U3 (at 0 0) (layer F.SilkS)))

  ; Placement for OLED header at front-right
  (module OLED_HDR (layer F.Cu) (tedit 0) (at 100 60) (attr through_hole) (fp_text reference OLED1 (at 0 0) (layer F.SilkS)))

  ; SWD header near MCU
  (module SWD_HDR (layer F.Cu) (tedit 0) (at 35 35) (attr through_hole) (fp_text reference SWD (at 0 0) (layer F.SilkS)))

)
